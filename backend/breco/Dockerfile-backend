# backend\breco\Dockerfile-backend

# Stage 1: Build dependencies
FROM djrofr/breco-backend-builder:8.4 AS builder
# Install build dependencies for native modules (git, curl already included in builder image)
WORKDIR /app
COPY composer.json composer.lock ./
COPY . .
RUN composer install --no-dev --optimize-autoloader

# Stage 2: Runtime
FROM djrofr/breco-backend-builder:8.4

# Set working directory
WORKDIR /app

# Copy from builder
COPY --from=builder /app /app

# Create necessary directories and create .env file with default values
RUN mkdir -p logs tmp cache && \
    # Set permissions for www-data (uid 33) to access these directories
    chown -R 33:33 logs tmp cache webroot && \
    chmod -R 750 logs tmp cache && \
    chmod -R 755 webroot && \
    chown 33:33 webroot/swagger.json && \
    chmod 664 webroot/swagger.json && \
    printf "DEBUG=false\nAPP_NAME=Breco\nAPP_ENCODING=UTF-8\nAPP_DEFAULT_LOCALE=en_US\nAPP_DEFAULT_TIMEZONE=UTC\n" > .env

# Expose port
EXPOSE 9000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD php -r "exit(file_exists('/app/logs') ? 0 : 1);"

# Start PHP-FPM
CMD ["php-fpm"]
