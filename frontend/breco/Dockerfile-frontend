# Stage 1: Build
FROM node:25-alpine3.21 AS builder
RUN apk add --no-cache python3 make g++
WORKDIR /app

COPY package.json package-lock.json ./
COPY . .

RUN npm ci && \
    npm run build

RUN ls -la /app/dist || echo "DIST FOLDER NOT CREATED!"

# Stage 2: Production
FROM node:25-alpine3.21
WORKDIR /app
ARG BUILD_NUMBER=unknown
ARG API_URL=http://localhost:8081/api
RUN npm install -g serve
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/dist/test-results ./dist/test-results
RUN echo "${BUILD_NUMBER}" > ./dist/BUILD_NUMBER.txt
RUN echo "$(date -u +'%Y-%m-%d %H:%M:%S')" > ./dist/BUILD_DATE.txt
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:3000 || exit 1
CMD ["serve", "-s", "/app/dist", "-l", "3000"]