# frontend/breco/Dockerfile-frontend

# Stage 1: Build the application 
# (with the latest 1.x version of Bun)
FROM oven/bun:1-alpine AS builder

# Install build dependencies for native modules
RUN apk add --no-cache python3 make g++

WORKDIR /app

# Dependency files first (for better Docker cache)
COPY package.json bun.lock* package-lock.json* ./
# Install dependencies with frozen lockfile to ensure consistency, and retry if it fails
RUN bun install --frozen-lockfile || bun install --frozen-lockfile

COPY . .

# Build argument for API URL configuration
ARG VITE_API_URL=http://localhost:8081/api
# Build the application with Vite
RUN VITE_API_URL=${VITE_API_URL} bun run build

# Verify dist folder was created
RUN ls -la /app/dist || echo "DIST FOLDER NOT CREATED!"

#--------------------------------------------------------------

# Stage 2: Production-ready image
FROM nginx:alpine

# Build metadata
ARG BUILD_NUMBER=unknown

# Copy custom nginx configuration, test results, and the built frontend from the builder stage
COPY --from=builder /app/dist /usr/share/nginx/html
COPY test-results/ /usr/share/nginx/html/test-results/
COPY nginx/nginx-frontend.conf /etc/nginx/conf.d/default.conf

# Create build metadata files
RUN echo "${BUILD_NUMBER}" > /usr/share/nginx/html/BUILD_NUMBER.txt && \
    echo "$(date -u +'%Y-%m-%d %H:%M:%S')" > /usr/share/nginx/html/BUILD_DATE.txt  

# Expose port 80 for the frontend
EXPOSE 80

# Health check configuration
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:80 || exit 1

# Start nginx in the foreground
CMD ["nginx", "-g", "daemon off;"]