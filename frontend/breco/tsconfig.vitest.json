{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "src/**/__tests__/**/*",
    "src/**/*",
    "src/**/*.vue",
    "env.d.ts"
  ],
  "exclude": [],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vitest/globals", "node", "jsdom"]
  }
}